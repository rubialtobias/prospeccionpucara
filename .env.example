# Copiá este archivo como .env y completá los valores. El .env nunca se comparte ni se sube.

# Clave de https://serper.dev (2.500 búsquedas gratis)
SERPER_API_KEY=

# Cuenta desde la que se envían los emails (se usa más adelante)
GMAIL_REMITENTE=tobias.pucaratech@gmail.com
NOMBRE_REMITENTE="Tobías | Pucará Technologies"

# Supabase (panel online). Project Settings -> API.
# La service_role da acceso total: solo va acá, nunca al panel ni al repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
